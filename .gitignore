# 虚拟环境：几百 MB，且别人能自己重建
.venv/

# Python 编译缓存
__pycache__/
*.pyc

# matplotlib 缓存
.mplconfig/
matplotlib-*/

# 训练日志
runs/

# 模型权重
models/

# pytest 的缓存目录：你一跑测试它就在根目录冒出来了
.pytest_cache/

# 这台机器上 pytest 建缓存失败的残留目录（详见 pytest.ini 里的说明）。
# 它们权限被锁住、删不掉，忽略掉才能让 git status 不再刷警告。
# 以后清理干净了可以删掉这一行。
pytest-cache-files-*/
